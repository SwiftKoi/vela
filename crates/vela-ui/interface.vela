# The interface Vela ships (SCREENS.md §2.1).
#
# One module, so its screens can `use` each other — a `use` resolves in the declaring file (SCREENS.md
# §2.1) and this is the interface's file. Every project module can name these screens: a project's own
# declaration of a name takes it over, and the rest keep working.
#
# What is here grows as M12.2's items land: `game_menu` is the frame the app screens are built on,
# `main_menu` and `pause` are where a game is entered and interrupted, `about` is the screen every game has,
# and `preferences` is the settings screen over the store. Save/load, history, help and notify follow. What an interface screen may rely on
# is deliberate and narrow, because a style resolves in the declaring module (SCREENS.md §5) and a
# project module using one of these would resolve the name against *its* table: the frame below — the one
# screen a project is expected to `use` — names no style at all and draws from widget defaults plus the
# `theme.*` colour a widget takes as a prop, while the app screens (which the interface *opens*, and which
# are therefore laid out in this module) may use styles declared here. Colours are the project's: a caller
# lays the game's palette over this one, token by token (SCREENS.md §2.7), so the three below are Vela's
# *fallbacks* for a game that names none of them.

theme interface:
    color bg = 0x14161d
    color fg = 0xe8e8ee
    color accent = 0x5aa9e6

style interface_choice:
    color = theme.fg
    selected_color = theme.accent

screen game_menu(title):
    box at = center, background = theme.bg:
        pad 32
        column gap = 16:
            text title
            transclude
            button:
                action close_screen()
                text "Return"

# The title screen. It has no title of its own: the interface cannot know what a game is called, and a
# placeholder name would be worse than none — a project that wants one takes this screen over, which is the
# rule everywhere else here. `Start` is `jump(start)`, and a bare label resolves in the module the game's
# entry point is in (`vela run` says which), so the conventional name is all this screen needs to know.
screen main_menu:
    box at = center, background = theme.bg:
        pad 48
        column gap = 16:
            button:
                action jump(start)
                text "Start", style = interface_choice
            button:
                action open_screen("preferences")
                text "Settings", style = interface_choice
            button:
                action open_screen("about")
                text "About", style = interface_choice
            button:
                action quit()
                text "Quit", style = interface_choice

# Escape during play, which is the runtime's own binding: it closes the top screen, or opens a screen
# called `pause` when nothing is open (`SCREENS.md §2`). So this screen is what makes Escape work in a
# project that declares no menu — and it is the game menu, with Save and Load to come when the slots have
# screens (M12.2's item 5).
screen pause:
    box at = center, background = theme.bg:
        pad 32
        column gap = 12:
            button:
                action close_screen()
                text "Resume", style = interface_choice
            button:
                action open_screen("preferences")
                text "Settings", style = interface_choice
            button:
                action open_screen("about")
                text "About", style = interface_choice
            button:
                action quit()
                text "Quit", style = interface_choice

screen about:
    use game_menu("About"):
        text "A game made with Vela."

# The settings, one section per group of `vela-ui::settings`' list. Every control is a *button*: the
# engine marks the one whose action writes what the store holds (`SCREENS.md §5.1`), so a choice needs no
# companion test and a toggle needs no state of its own. Numeric settings are a row of values rather than
# a slider, because a slider is a drag and the host delivers semantic actions rather than coordinates
# (`§11`) — which also makes this screen answer to a keyboard, the way a game's settings must.
screen preferences:
    use game_menu("Preferences"):
        column gap = 16:
            text "Display"
            row gap = 12:
                button:
                    action preference("display_mode", "window")
                    text "Window", style = interface_choice
                button:
                    action preference("display_mode", "fullscreen")
                    text "Fullscreen", style = interface_choice
            text "Text speed"
            row gap = 12:
                button:
                    action preference("text_speed", 0)
                    text "Instant", style = interface_choice
                button:
                    action preference("text_speed", 30)
                    text "Slow", style = interface_choice
                button:
                    action preference("text_speed", 60)
                    text "Normal", style = interface_choice
            text "Auto-forward"
            row gap = 12:
                button:
                    action toggle_preference("auto_forward")
                    text "Auto-forward", style = interface_choice
            text "Auto-forward delay"
            row gap = 12:
                button:
                    action preference("auto_forward_time", 5)
                    text "5s", style = interface_choice
                button:
                    action preference("auto_forward_time", 15)
                    text "15s", style = interface_choice
                button:
                    action preference("auto_forward_time", 30)
                    text "30s", style = interface_choice
            text "Skipping"
            row gap = 12:
                button:
                    action toggle_preference("skip_unseen")
                    text "Unseen text", style = interface_choice
                button:
                    action toggle_preference("skip_after_choices")
                    text "After choices", style = interface_choice
                button:
                    action toggle_preference("transitions")
                    text "Transitions", style = interface_choice
